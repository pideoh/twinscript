{
  "name": "twinscript",
  "productName": "Twinscript",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "Real-time speech transcription and two-way translation for meetings (static web app / PWA)",
  "author": "Hideo Sumi",
  "main": "app/main.js",
  "scripts": {
    "start": "python3 -m http.server 5173",
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e/*.e2e.js",
    "test:app": "node --test test/app/*.app.js",
    "app": "node -e \"process.platform === 'darwin' && require('node:child_process').execFileSync('sh', ['scripts/build-mac-helper.sh'], { stdio: 'inherit' })\" && electron .",
    "build:mac-helper": "sh scripts/build-mac-helper.sh",
    "dist:mac": "sh scripts/build-mac-helper.sh && electron-builder --mac zip --arm64 --x64",
    "dist:win": "electron-builder --win zip --x64"
  },
  "type": "module",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.50.0"
  },
  "build": {
    "appId": "io.github.pideoh.twinscript",
    "productName": "Twinscript",
    "directories": { "output": "dist" },
    "files": [
      "app/**/*",
      "index.html",
      "styles.css",
      "icons/**/*",
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "artifactName": "twinscript-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": "zip",
      "category": "public.app-category.productivity",
      "icon": "icons/icon-512.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [{ "from": "native/mac/build/system-audio", "to": "system-audio" }],
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "会議の音声を文字起こしするためにマイクを使います。",
        "NSAudioCaptureUsageDescription": "PC音声（会議アプリの相手の声など）を文字起こしするためにシステムの音声を取り込みます。"
      }
    },
    "win": {
      "target": "zip",
      "icon": "icons/icon-512.png"
    }
  }
}
