{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:e2e)",
      "Bash(node --test *)"
    ],
    "deny": [
      "Read(node_modules/**)",
      "Read(package-lock.json)",
      "Read(icons/*.png)"
    ]
  },
  "bashOutputMaxChars": 10000,
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "10000"
  }
}
